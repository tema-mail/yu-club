---
// S4-111. Список публикаций (12 §8.2): карточка – обложка, дата, заголовок-ссылка, подводка, охват словами (K22 §4).
// Пусто – понятное пустое состояние (12 §14.1), а не пропавший раздел. Порядок – как отдал API (publish_from DESC).
// Карточки: одна колонка на телефоне, дальше – сетка от 300 px; обложка – webp-варианты из медиатеки, lazy.
import { publicationPath } from '../../../../packages/contracts/src/paths.ts';
import type { PublicationCard } from '../lib/content.ts';
import { formatDay, scopeText } from '../lib/publications.ts';

interface Props {
  items: PublicationCard[];
  timeZone: string;
  empty: string;
  /** Уровень заголовка карточки: на хабе – h2, в блоке главной – h3. */
  level?: 2 | 3;
  testid?: string;
}

const { items, timeZone, empty, level = 2, testid = 'publications' } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const srcset = (c: PublicationCard['cover']) => c?.variants.filter((v) => v.format === 'webp').map((v) => `${v.url} ${v.w}w`).join(', ') || undefined;
---
{items.length === 0 ? (
  <p class="yu-notice" role="status" data-testid={`${testid}-empty`}>{empty}</p>
) : (
  <ul class="pub-list" data-testid={testid}>
    {items.map((p) => (
      <li class="pub-card">
        {p.cover && !p.cover.removed && p.cover.url && (
          <img class="pub-card__cover" src={p.cover.url} srcset={srcset(p.cover)} sizes="(min-width: 900px) 360px, 100vw" alt={p.cover.alt} width={p.cover.width ?? undefined} height={p.cover.height ?? undefined} loading="lazy" decoding="async" />
        )}
        <div class="pub-card__body">
          <p class="pub-card__date">
            {p.type === 'promotion' && p.publishTo ? `до ${formatDay(p.publishTo, timeZone)}` : formatDay(p.eventDate ?? p.publishFrom, timeZone)}
          </p>
          <H class="pub-card__title"><a class="pub-card__link" href={publicationPath(p.type, p.slug)}>{p.title}</a></H>
          {p.lead && <p class="pub-card__lead">{p.lead}</p>}
          <p class="pub-card__scope" data-testid="pub-scope">{scopeText(p.onlyIn)}</p>
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .pub-list { display: grid; gap: var(--yu-sp-s); grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); margin: 0; padding: 0; list-style: none; }
  .pub-card { position: relative; min-width: 0; display: grid; align-content: start; border: 1px solid var(--yu-line-soft); border-radius: var(--yu-r-m); background: var(--yu-surface); overflow: hidden; }
  .pub-card:hover { border-color: var(--yu-accent); }
  .pub-card__cover { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--yu-surface-2); }
  .pub-card__body { display: grid; gap: var(--yu-sp-3xs); padding: var(--yu-sp-s); }
  .pub-card__body > * { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .pub-card__date, .pub-card__scope { color: var(--yu-dim); font-size: var(--yu-fs-xs); }
  .pub-card__title { font-size: var(--yu-fs-l); line-height: var(--yu-lh-head); }
  .pub-card__link { display: inline-block; min-height: var(--yu-tap); padding-block: 10px; text-decoration: none; color: var(--yu-text); }
  .pub-card__link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .pub-card__lead { color: var(--yu-muted); font-size: var(--yu-fs-m); } /* основной текст карточки – 16 px (S4-133) */
</style>

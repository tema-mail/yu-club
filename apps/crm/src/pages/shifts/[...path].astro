---
// Смены сотрудников (K18 №301–310): /shifts – расписание (S3-71, shift.view), /shifts/my – своё (S3-72, shift.view.own).
// Решает всё равно сервер (K1): чужой филиал – 404, без права – 403.
import Crm from '../../layouts/Crm.astro';
import MySchedule from '../../islands/MySchedule.tsx';
import ShiftCalendar from '../../islands/ShiftCalendar.tsx';
import { serverCall } from '../../lib/api.ts';
import { today as todayIn } from '../../lib/booking.ts';

const { me, cookie, ctx, branches } = Astro.locals;
const can = (a: string) => me.actions.includes(a);
const segments = (Astro.params.path ?? '').split('/').filter(Boolean);
const key = segments[0] ?? '';

const fullName = `${me.staff.firstName} ${me.staff.lastName}`;
const isMy = key === 'my';
let notFound = segments.length > 1 || (isMy ? !can('shift.view.own') : key !== '' || !can('shift.view'));
if (branches.length === 0) notFound = true;

/** Имена – только с staff.view (Владелец, Директор): Администратору API список не отдаёт. */
async function staffList() {
  const list: Array<{ id: string; name: string }> = [];
  if (!can('staff.view')) return list;
  let cursor: string | null = null;
  for (let page = 0; page < 20; page++) {
    const q: string = cursor ? `&cursor=${encodeURIComponent(cursor)}` : '';
    const r: { items: Array<{ id: string; firstName: string; lastName: string }>; nextCursor: string | null } = await serverCall(cookie, `/staff?limit=100${q}`);
    for (const s of r.items) list.push({ id: s.id, name: `${s.firstName} ${s.lastName}` });
    if (!r.nextCursor) break;
    cursor = r.nextCursor;
  }
  return list;
}
const staff = notFound ? [] : await staffList();
if (notFound) Astro.response.status = 404;

const zone = branches.map((b) => ({ id: b.id, name: b.name, timezone: b.timezone }));
const first = ctx.kind === 'branch' ? ctx.branch : (branches[0] ?? null);
const staffNames = Object.fromEntries(staff.map((x) => [x.id, x.name]));
const title = notFound ? 'Не найдено' : isMy ? 'Моё расписание' : 'Расписание сотрудников';
---
<Crm title={title}>
  {notFound ? (
    <div class="yc-panel" role="alert" data-testid="not-found">
      <h1>Страница не найдена</h1>
      <p>Такой записи нет или она вне вашей зоны доступа. Проверьте ссылку.</p>
      <p><a href="/">На главную</a></p>
    </div>
  ) : (
    <>
      <div class="yc-head"><h1>{title}</h1></div>
      {isMy && <MySchedule client:load meId={me.staff.id} branches={zone} today={todayIn(first!.timezone)} staffNames={staffNames} />}
      {!isMy && <ShiftCalendar client:load branches={zone} staff={staff} meId={me.staff.id} meName={fullName} initialBranchId={first!.id} today={todayIn(first!.timezone)}
        canManage={can('shift.manage')} canStaffCard={can('staff.view')} />}
    </>
  )}
</Crm>

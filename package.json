{
  "name": "yu-club",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "db"
  ],
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "16.15.0-beta.19",
    "eslint": "^10.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@16.15.0-beta.19": true
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run check -w @yu/crm && npm run check -w @yu/site",
    "test": "vitest run",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "dev:api": "node apps/api/src/server.ts",
    "lint": "eslint .",
    "build:crm": "npm run build -w @yu/crm",
    "test:crm": "npm run test:e2e -w @yu/crm",
    "build:site": "npm run build -w @yu/site",
    "test:site": "npm run test:e2e -w @yu/site",
    "load:race": "node tests/load/booking-race.ts",
    "load:money": "node tests/load/money-race.ts",
    "load:club": "node tests/load/club-race.ts",
    "gift:ensure": "node db/seed/gift-resources.ts",
    "test:e2e:stand": "playwright test -c tests/e2e/playwright.config.ts",
    "load:campaign": "node tests/load/campaign.ts"
  }
}

---
// Сотрудники (S0-15c, staff/routes.staff.ts): /staff – список зоны, /staff/new – создание, /staff/{id} – карточка.
// Экран – при staff.view (Владелец, Директор); Администратору – 404, как несуществующей странице.
// Опция «Директор» в создании – только при staff.director.assign (Владелец). Решает всё равно сервер (K1).
// S3-70: блок ставок (K18 №309) – при payroll.view; текущий planning_status API в карточке не отдаёт: читаем последнюю запись журнала staff.planning_changed.
import Crm from '../../layouts/Crm.astro';
import EntityList from '../../islands/EntityList.tsx';
import StaffForm, { type StaffItem } from '../../islands/StaffForm.tsx';
import StaffRates, { type PlanningStatus } from '../../islands/StaffRates.tsx';
import { ApiError, ROLE_LABEL, serverCall, type StaffRole } from '../../lib/api.ts';
import { today as todayIn } from '../../lib/booking.ts';
import type { StaffRate } from '../../lib/shifts.ts';

const STATUS_LABEL = { active: 'Работает', blocked: 'Заблокирован', archived: 'В архиве' };

const { me, cookie, ctx, branches } = Astro.locals;
const can = (a: string) => me.actions.includes(a);
const [key = '', extra] = (Astro.params.path ?? '').split('/');

let notFound = extra !== undefined || !can('staff.view') || (key === 'new' && !can('staff.admin.assign'));
let staff: StaffItem | null = null;
if (!notFound && key && key !== 'new') {
  try {
    staff = await serverCall<StaffItem>(cookie, `/staff/${encodeURIComponent(key)}`);
  } catch (e) {
    if (!(e instanceof ApiError) || ![400, 403, 404].includes(e.status)) throw e;
    notFound = true;
  }
}
if (notFound) Astro.response.status = 404;

const roleOptions = (['admin', 'director'] as StaffRole[])
  .filter((r) => can(r === 'admin' ? 'staff.admin.assign' : 'staff.director.assign'))
  .map((r) => ({ value: r, label: ROLE_LABEL[r] }));
const zoneBranches = branches.map((b) => ({ id: b.id, name: b.name, cityId: b.cityId, cityName: b.cityName }));
const timezone = (ctx.kind === 'branch' ? ctx.branch.timezone : branches[0]?.timezone) ?? 'Asia/Novosibirsk';

const self = staff?.id === me.staff.id;
const canAssign = staff ? can(staff.role === 'admin' ? 'staff.admin.assign' : 'staff.director.assign') : false;
const canRole = canAssign && !self && staff?.role !== 'owner';
const canBlock = Boolean(staff) && can('staff.block') && !self && (staff?.role === 'admin' || me.staff.role === 'owner');

// S3-70: ставки и планирование
let rates: StaffRate[] | null = null;
let planning: PlanningStatus | null = null;
const staffNames: Record<string, string> = {};
if (staff) {
  if (can('payroll.view')) {
    try {
      rates = (await serverCall<{ items: StaffRate[] }>(cookie, `/staff/${encodeURIComponent(staff.id)}/rates`)).items;
    } catch (e) {
      if (!(e instanceof ApiError) || ![403, 404].includes(e.status)) throw e;
    }
  }
  try {
    let cursor: string | null = null;
    for (let page = 0; page < 5 && planning === null; page++) {
      const q: string = cursor ? `&cursor=${encodeURIComponent(cursor)}` : '';
      const r: { items: Array<{ action: string; after?: { planningStatus?: PlanningStatus } }>; nextCursor: string | null } = await serverCall(cookie, `/audit/timeline?objectType=staff&objectId=${encodeURIComponent(staff.id)}&limit=100${q}`);
      planning = r.items.find((x) => x.action === 'staff.planning_changed')?.after?.planningStatus ?? null;
      if (planning === null && !r.nextCursor) planning = 'available'; // журнал прочитан целиком, отметок не было
      cursor = r.nextCursor;
    }
  } catch (e) {
    if (!(e instanceof ApiError) || ![403, 404].includes(e.status)) throw e;
  }
  let cursor: string | null = null;
  for (let page = 0; page < 20; page++) {
    const q: string = cursor ? `&cursor=${encodeURIComponent(cursor)}` : '';
    const r: { items: Array<{ id: string; firstName: string; lastName: string }>; nextCursor: string | null } = await serverCall(cookie, `/staff?limit=100${q}`);
    for (const x of r.items) staffNames[x.id] = `${x.firstName} ${x.lastName}`;
    if (!r.nextCursor) break;
    cursor = r.nextCursor;
  }
}
const live = staff?.assignments ?? [];
const workFrom = live.map((a) => a.validFrom).sort()[0] ?? null;
const workTo = live.length > 0 && live.every((a) => a.validTo) ? live.map((a) => a.validTo!).sort().at(-1)! : null;

const title = notFound ? 'Не найдено' : staff ? `${staff.lastName} ${staff.firstName}` : key === 'new' ? 'Новый сотрудник' : 'Сотрудники';
---
<Crm title={title}>
  {notFound ? (
    <div class="yc-panel" role="alert" data-testid="not-found">
      <h1>Страница не найдена</h1>
      <p>Такой записи нет или она вне вашей зоны доступа. Проверьте ссылку.</p>
      <p><a href="/">На главную</a></p>
    </div>
  ) : (
    <>
      <div class="yc-head">
        {key && <p class="yc-crumbs"><a href="/staff">Сотрудники</a> / {title}</p>}
        <h1>{title}</h1>
        {staff && <p>{ROLE_LABEL[staff.role]} · <span class={`yc-badge yc-badge--${staff.status}`}>{STATUS_LABEL[staff.status]}</span></p>}
      </div>

      {!key && (
        <>
          {can('staff.admin.assign') && (
            <nav class="yc-tabs" aria-label="Сотрудники">
              <a class="yc-btn yc-tabs__action" href="/staff/new">Добавить сотрудника</a>
            </nav>
          )}
          <section class="yc-panel" aria-label="Список сотрудников">
            <EntityList client:load testId="staff" endpoint="/staff" rowHref="/staff/{id}" pageSize={20}
              search={{ label: 'Поиск по имени и почте', param: 'q' }}
              filters={[
                { param: 'role', label: 'Роль', options: [{ value: '', label: 'Все' }, ...(['owner', 'director', 'admin'] as StaffRole[]).map((r) => ({ value: r, label: ROLE_LABEL[r] }))] },
                { param: 'status', label: 'Статус', options: [{ value: '', label: 'Все' }, ...Object.entries(STATUS_LABEL).map(([value, label]) => ({ value, label }))] },
              ]}
              columns={[
                { key: 'lastName', label: 'Фамилия', main: true }, { key: 'firstName', label: 'Имя' },
                { key: 'role', label: 'Роль', labels: ROLE_LABEL }, { key: 'email', label: 'Почта' },
                { key: 'status', label: 'Статус', badge: STATUS_LABEL },
              ]}
              emptyText="В вашей зоне пока нет сотрудников." />
          </section>
        </>
      )}

      {(key === 'new' || staff) && (
        <StaffForm client:load staff={staff ?? undefined} branches={zoneBranches} cityIds={me.access.cityIds}
          roleOptions={key === 'new' || canRole ? roleOptions : []} roleLabels={ROLE_LABEL} statusLabels={STATUS_LABEL}
          canProfile={canAssign} canRole={canRole} canScope={canRole} canBlock={canBlock} timezone={timezone} />
      )}
      {staff && (
        <StaffRates client:load staffId={staff.id} initialRates={rates} canManage={can('payroll.rate.manage')} canPlanning={can('staff.planning_status')}
          initialPlanning={planning} workFrom={workFrom} workTo={workTo} today={todayIn(timezone)} staffNames={staffNames} />
      )}
    </>
  )}
</Crm>

---
// Хаб филиала /{city}/{branch}/ (карта сайта 3.1): адрес и часы сегодня – из GET /branches/{id} (hoursToday, 12 приёмка 23),
// зоны – из ресурсов (K5 №4). Нет часов на сегодня – «закрыто сегодня», а не ошибка.
// Нет такого города или филиала (в т.ч. 'preparing'/'archived' – K5 их не отдаёт) – 404 с кодом 404.
// Временно закрытый – страница остаётся, плашка, без слотов и записи (12 §4.3, карта п.2.12).
// Зоны – разделы этой страницы (#rooms, отдельных страниц зон нет); комната – ссылка на свою карточку (S1-21),
// у зоны – запись с предвыбором зоны. Нет опубликованных комнат – пустое состояние, а не пропавший раздел.
// Запись – кнопкой в /schedule/?branch={город}/{филиал} (карта п.2.9: своего адреса расписания у филиала нет); у закрытого её нет.
import Site from '../../../layouts/Site.astro';
import {
  ApiError, ZONE_LABEL, ZONE_ORDER, branchPath, branchRooms, findBranch, roomPath, scheduleHref, site,
  type BranchDetailDto, type ResourceDto,
} from '../../../lib/api.ts';
import { metaFor } from '../../../lib/seo.ts';
import { branchLd, breadcrumbLd, organizationLd } from '../../../lib/jsonld.ts';

const { city: citySlug = '', branch: branchSlug = '' } = Astro.params;
const { network, origin } = Astro.locals;

const found = network ? findBranch(network, citySlug, branchSlug) : null;
if (network && !found) return Astro.rewrite('/404/');

let resources: ResourceDto[] = [];
let detail: BranchDetailDto | null = null;
let failed = !network;
if (found) {
  try {
    [resources, detail] = await Promise.all([site.resources(found.branch.id), site.branch(found.branch.id)]);
  } catch (e) {
    if (e instanceof ApiError && e.status === 404) return Astro.rewrite('/404/');
    console.error('site: филиал из API не загрузился', e);
    failed = true;
  }
}
if (failed) Astro.response.status = 503;

const city = found?.city;
const branch = detail ?? found?.branch;
const closed = branch?.status === 'temporarily_closed';
const hours = detail?.hoursToday ?? [];
const hoursToday = hours.length === 0 ? 'Закрыто сегодня' : hours.map((i) => `${i.start}–${i.end}`).join(', ');

// Зоны → комнаты → места. Порядок зон фиксированный, пустые зоны не показываем. Адрес комнаты – branchRooms (один на филиал).
const slugs = new Map(branchRooms(resources).map((r) => [r.id, r.slug]));
const zones = ZONE_ORDER.map((code) => {
  const items = resources.filter((r) => r.zone === code);
  const rooms = new Map<string, { name: string; slug: string | null; items: ResourceDto[] }>();
  for (const r of items) {
    const key = r.roomId ?? r.id;
    const room = rooms.get(key) ?? { name: r.roomName ?? r.name, slug: r.roomId ? (slugs.get(r.roomId) ?? null) : null, items: [] };
    room.items.push(r);
    rooms.set(key, room);
  }
  return { code, label: ZONE_LABEL[code], rooms: [...rooms.values()] };
}).filter((z) => z.rooms.length > 0);

const title = branch && city ? `${branch.name}, ${city.name}` : 'Клуб временно недоступен';
// Адрес, координаты и фото из страницы CMS (postal, geo, gallery) добавит S4-121: нет данных – нет полей (K23 §6).
const jsonLd = branch && city
  ? [
      organizationLd(origin),
      branchLd(origin, { path: branchPath(city.slug, branch.slug), name: branch.name, status: branch.status, phone: branch.phone, weeklyHours: detail?.weeklyHours }),
      breadcrumbLd(origin, [{ name: 'Главная', path: '/' }, ...(city.branches.length >= 2 ? [{ name: city.name, path: `/${city.slug}/` }] : []), { name: branch.name, path: branchPath(city.slug, branch.slug) }]),
    ]
  : [];
const meta = branch && city
  ? metaFor({ page: 'branch', branch: branch.name, city: city.name, address: branch.address, directions: zones.map((z) => ZONE_LABEL[z.code]), hoursToday: closed ? 'Временно закрыт' : `Сегодня: ${hoursToday}`, closed })
  : null;
const hasCityHub = (city?.branches.length ?? 0) >= 2;
---
<Site title={meta?.title ?? `${title} – Ю-Клуб`} description={meta?.description} index={{ kind: 'branch', status: branch?.status ?? 'active' }} jsonLd={jsonLd}>
  {failed || !branch || !city ? (
    <section class="yu-error">
      <span class="yu-error__code">503</span>
      <h1>Страница клуба временно недоступна</h1>
      <p class="yu-body">Сервис не ответил. Обновите страницу через минуту.</p>
    </section>
  ) : (
    <>
      <ol class="yu-crumbs" aria-label="Навигация">
        <li><a href="/">Главная</a></li>
        <li>{hasCityHub ? <a href={`/${city.slug}/`}>{city.name}</a> : city.name}</li>
        <li aria-current="page">{branch.name}</li>
      </ol>
      <section class="yu-hero">
        <div>
          <h1 data-testid="branch-title">{meta?.h1 ?? branch.name}</h1>
          <p class="yu-lead">{city.name}, {branch.address}</p>
          {closed ? (
            <p class="yu-notice" role="status" data-testid="branch-closed">Клуб временно закрыт. Онлайн-запись в нём сейчас недоступна.</p>
          ) : (
            <a class="yu-btn" href={`/schedule/?branch=${city.slug}/${branch.slug}`} data-testid="branch-book">Записаться онлайн</a>
          )}
        </div>
        <dl class="yu-facts">
          <div>
            <dt>Адрес</dt>
            <dd data-testid="branch-address">{branch.address}</dd>
          </div>
          <div>
            <dt>Сегодня</dt>
            <dd data-testid="branch-hours">{closed ? 'Временно закрыт' : hoursToday}</dd>
          </div>
        </dl>
      </section>

      <section class="yu-section" id="rooms" aria-labelledby="zones-title">
        <h2 id="zones-title">Зоны и комнаты</h2>
        {zones.length === 0 ? (
          <p class="yu-body" data-testid="zones-empty">Комнаты клуба пока не опубликованы. Уточните у администратора клуба, что можно забронировать.</p>
        ) : (
          <div class="yu-zones">
            {zones.map((z) => (
              <article class="yu-zone" data-testid={`zone-${z.code}`}>
                <h3>{z.label}</h3>
                <ul class="yu-zone__rooms">
                  {z.rooms.map((room) => (
                    <li class="yu-zone__room">
                      {room.slug
                        ? <a class="yu-zone__room-name" href={roomPath(city.slug, branch.slug, room.slug)}>{room.name}</a>
                        : <span class="yu-zone__room-name">{room.name}</span>}
                      <ul class="yu-chips">
                        {room.items.map((r) => <li class="yu-chip">{r.name}</li>)}
                      </ul>
                    </li>
                  ))}
                </ul>
                {!closed && <a class="yu-btn yu-btn--ghost yu-zone__book" href={scheduleHref(city.slug, branch.slug, { zone: z.code })}>Записаться</a>}
              </article>
            ))}
          </div>
        )}
      </section>
    </>
  )}
</Site>

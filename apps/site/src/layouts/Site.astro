---
// Оболочка сайта: шапка (знак, навигация, выбор клуба), подвал (юридические ссылки), canonical и robots по режиму.
// Данные сети и выбор посетителя кладёт middleware (src/middleware.ts) – здесь только показ.
// В меню – только разделы, у которых уже есть страница; запись добавит свой шаг (S1-19…S1-21). «Войти / Кабинет» – по куке сессии.
import '../styles/site.css';
import BranchPicker, { type PickerCity } from '../islands/BranchPicker.tsx';
import UnreadBadge from '../islands/UnreadBadge.tsx';
import { robotsFor, type IndexInput } from '../lib/seo.ts';
import { serializeJsonLd, type JsonLd } from '../lib/jsonld.ts';

interface Props {
  title: string;
  description?: string;
  /** Страница закрыта от поиска и на бою (404, юридические – карта сайта 3.4, 3.5). */
  noindex?: boolean;
  /** Единое решение индексации K23 §2 (lib/seo.ts): важнее noindex; без него – закрыто только то, что закрыто флагом. */
  index?: IndexInput;
  /** OpenGraph K23 §4: картинка – JPEG из CMS; нет – тега нет, общий логотип появится с макетом заказчика (TEHDOLG). */
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  /** Микроразметка K23 §6 (lib/jsonld.ts); пустые значения отброшены построителем. */
  jsonLd?: ReadonlyArray<JsonLd | null>;
}

const { title, description, noindex = false, index, ogImage = null, ogType = 'website', jsonLd = [] } = Astro.props;
const { network, choice, indexable, origin, hasSession } = Astro.locals;
// Адрес, который запросил посетитель: внутренняя подмена (/about/ → /info/about/, S4-120) не меняет canonical.
const path = Astro.originPathname;
// canonical – адрес без параметров (карта сайта п.2.10).
const canonical = `${origin}${path}`;
const robots = robotsFor(index ?? (noindex ? { kind: 'closed' } : { kind: 'open' }), indexable) === 'index' ? 'index, follow' : 'noindex, nofollow';
const ogImageUrl = ogImage ? new URL(ogImage, origin).href : null;

const pickerCities: PickerCity[] = (network ?? []).map((c) => ({
  slug: c.slug,
  name: c.name,
  branches: c.branches.map((b) => ({ slug: b.slug, name: b.name, address: b.address, status: b.status })),
}));

const NAV = [{ href: '/', label: 'Клубы', active: (p: string) => p === '/' }];
const LEGAL = [
  { href: '/rules/', label: 'Правила клуба' },
  { href: '/privacy-policy/', label: 'Политика обработки персональных данных' },
  { href: '/personal-data-consent/', label: 'Согласие на обработку персональных данных' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ю-Клуб" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {jsonLd.filter((d) => d !== null).map((d) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(d)} />)}
    <meta name="theme-color" content="#0b0d12" />
  </head>
  <body>
    <a class="yu-skip" href="#main">К содержимому</a>
    <header class="yu-header">
      <div class="yu-page yu-header__row">
        <a class="yu-brand" href="/" aria-label="Ю-Клуб, на главную">
          <span class="yu-brand__mark" aria-hidden="true">Ю</span>
          <span>Ю-Клуб</span>
        </a>
        <nav class="yu-nav" aria-label="Разделы">
          <ul class="yu-nav__list">
            {NAV.map((n) => (
              <li><a class="yu-nav__link" href={n.href} aria-current={n.active(path) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="yu-header__picker">
          <BranchPicker client:load cities={pickerCities} current={choice} />
        </div>
        {hasSession && <UnreadBadge client:load />}
        <a
          class="yu-header__account"
          href={hasSession ? '/account/' : '/login/'}
          aria-current={path.startsWith('/account/') || path === '/login/' ? 'page' : undefined}
          data-testid="header-account"
        >{hasSession ? 'Кабинет' : 'Войти'}</a>
      </div>
    </header>
    {!hasSession && (
      <script>
        // Вход без перезагрузки (в оформлении записи): после события входа – ссылка в кабинет.
        import { SIGNED_IN_EVENT } from '../lib/client.ts';
        window.addEventListener(SIGNED_IN_EVENT, () => {
          const a = document.querySelector<HTMLAnchorElement>('[data-testid="header-account"]');
          if (!a) return;
          a.href = '/account/';
          a.textContent = 'Кабинет';
        });
      </script>
    )}

    <main class="yu-main" id="main" tabindex="-1">
      <div class="yu-page">
        <slot />
      </div>
    </main>

    <footer class="yu-footer">
      <div class="yu-page yu-footer__row">
        <div>
          <p class="yu-footer__title">Ю-Клуб</p>
          <p class="yu-footer__copy">Сеть компьютерных клубов: ПК, VR, PlayStation и комнаты.</p>
          <p class="yu-footer__copy">© {year} Ю-Клуб</p>
        </div>
        <nav aria-label="Клубы">
          <p class="yu-footer__title">Клубы</p>
          <ul class="yu-footer__list">
            {(network ?? []).map((c) => (
              <li><a class="yu-footer__link" href={c.branches.length === 1 ? `/${c.slug}/${c.branches[0]!.slug}/` : `/${c.slug}/`}>{c.name}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Документы">
          <p class="yu-footer__title">Документы</p>
          <ul class="yu-footer__list">
            {LEGAL.map((l) => <li><a class="yu-footer__link" href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Значок непрочитанных (S4-124): 44 px – правило касания; число – поверх, слово – в aria-label. */
  .yu-bell { position: relative; display: inline-flex; align-items: center; justify-content: center; flex: none; width: var(--yu-tap); height: var(--yu-tap); border-radius: var(--yu-r-s); color: var(--yu-text); }
  .yu-bell:hover { background: var(--yu-surface-2); }
  .yu-bell__count { position: absolute; top: 2px; right: 0; min-width: 18px; padding: 0 4px; border-radius: 9px; background: var(--yu-accent); color: var(--yu-on-accent); font-size: 11px; font-weight: 800; line-height: 18px; text-align: center; }
</style>

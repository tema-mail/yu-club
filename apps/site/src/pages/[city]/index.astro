---
// Хаб города /{city}/ (3.1, п.2.11): ≥ 2 открытых филиала – список; один – 301 на филиал; нет города в публичном
// списке (K5 №1 отдаёт только города с active/temporarily_closed) – 404. Юридические, /rules/ и /about/ сюда не попадают:
// middleware подменяет их на src/pages/info/[key].astro (S4-120).
import Site from '../../layouts/Site.astro';
import { branchPath } from '../../lib/api.ts';
import { metaFor } from '../../lib/seo.ts';
import { breadcrumbLd } from '../../lib/jsonld.ts';

const { city: slug = '' } = Astro.params;
const { network, origin } = Astro.locals;
const city = network?.find((c) => c.slug === slug);

if (network && !city) return Astro.rewrite('/404/');
if (city && city.branches.length === 1) return Astro.redirect(`${branchPath(city.slug, city.branches[0]!.slug)}${Astro.url.search}`, 301);
if (!network) Astro.response.status = 503;

const meta = city ? metaFor({ page: 'city', city: city.name, branches: city.branches.map((b) => b.name) }) : null;
---
<Site
  title={meta?.title ?? 'Клубы временно недоступны – Ю-Клуб'}
  description={meta?.description}
  index={city ? { kind: 'city', openBranches: city.branches.length } : { kind: 'closed' }}
  jsonLd={city ? [breadcrumbLd(origin, [{ name: 'Главная', path: '/' }, { name: city.name, path: `/${slug}/` }])] : []}
>
  {!city ? (
    <section class="yu-error">
      <span class="yu-error__code">503</span>
      <h1>Список клубов временно недоступен</h1>
      <p class="yu-body">Сервис не ответил. Обновите страницу через минуту.</p>
    </section>
  ) : (
    <>
      <ol class="yu-crumbs" aria-label="Навигация">
        <li><a href="/">Главная</a></li>
        <li aria-current="page">{city.name}</li>
      </ol>
      <section class="yu-hero">
        <div>
          <h1>{meta?.h1}</h1>
          <p class="yu-lead">Выберите клуб: адрес, часы работы и зоны.</p>
        </div>
      </section>
      <section class="yu-section" aria-label="Клубы города">
        <ul class="yu-cards">
          {city.branches.map((b) => (
            <li class="yu-card">
              <a class="yu-card__link" href={branchPath(city.slug, b.slug)}>{b.name}</a>
              <span class="yu-card__meta">{b.address}</span>
              {b.status === 'temporarily_closed'
                ? <span class="yu-card__status yu-card__status--closed">Временно закрыт</span>
                : <span class="yu-card__status">Работает</span>}
            </li>
          ))}
        </ul>
      </section>
    </>
  )}
</Site>

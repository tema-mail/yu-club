---
// Основное действие сайта «Выбрать время» (ТЗ 19 §4.1–4.2, D4-66): ведёт в /schedule/ с клубом и, если задана, комнатой.
// На телефоне (до 900 px) – липкая панель у нижнего края экрана: кнопка действия всегда под рукой (правило владельца).
// С 900 px панели нет – та же кнопка стоит в первом экране страницы. Ставится последним в содержимом страницы:
// position: sticky держит панель внизу, пока страница не докручена до конца, у подвала она уезжает вместе с содержимым.
// У временно закрытого клуба записи нет – страница панель не ставит.
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Выбрать время' } = Astro.props;
---
<div class="yu-cta-bar" data-testid="time-cta-bar">
  <a class="yu-btn yu-cta-bar__btn" href={href} data-testid="time-cta">{label}</a>
</div>

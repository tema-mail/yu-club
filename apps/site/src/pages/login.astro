---
// Вход и регистрация клиента – один сценарий (K9, карта сайта 3.5): телефон → код из SMS → согласие → вход.
// Согласие на обработку ПДн – отдельная пустая галочка (152-ФЗ ст. 9); без неё кнопка «Войти» неактивна.
// С живой сессией middleware сразу уводит на ?next= (или в кабинет). Закрыта от поиска.
// S4-126: согласие на рекламу – отдельная пустая галочка со ссылкой на /advertising-consent/, только если документ опубликован (K5 №215);
// версию в журнал согласий пишет API – живую версию страницы, а не присланную сайтом (K9, K22 §7). Документа нет – галочки нет.
// Возраст (Q-34, умолчание до ответа юриста заказчика): кабинет – от 14 лет, за младшего – родитель на свой номер; подтверждение
// возраста – в тексте той же галочки (ГК ст. 26, 28: до 14 лет согласие даёт законный представитель).
import Site from '../layouts/Site.astro';
import { content } from '../lib/content.ts';

let advertising: string | null = null;
try {
  advertising = (await content.legalVersions()).advertisingConsent;
} catch (e) {
  console.error('site: версии документов не загрузились – вход без галочки рекламы', e);
}
---
<Site title="Вход в личный кабинет – Ю-Клуб" noindex>
  <section class="yu-auth" aria-labelledby="auth-title">
    <h1 id="auth-title">Вход в кабинет</h1>
    <p class="yu-body">По номеру телефона и коду из SMS. Если вы у нас впервые, кабинет создастся сам.</p>
    <p class="yu-body" data-testid="age-note">Кабинет заводит человек от 14 лет. Ребёнку младше кабинет на свой номер заводит родитель.</p>

    <form class="yu-form" id="phone-form" novalidate>
      <label class="yu-field">
        <span class="yu-field__label">Телефон</span>
        <input class="yu-input" id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required />
      </label>
      <button class="yu-btn" type="submit" id="phone-submit">Получить код</button>
    </form>

    <form class="yu-form" id="code-form" novalidate hidden>
      <p class="yu-body" id="code-sent" aria-live="polite"></p>
      <label class="yu-field">
        <span class="yu-field__label">Код из SMS</span>
        <input class="yu-input" id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required />
      </label>
      <label class="yu-check">
        <input type="checkbox" id="consent" name="consent" />
        <span>Мне есть 14 лет, и я даю <a href="/personal-data-consent/" target="_blank" rel="noopener">согласие на обработку персональных данных</a></span>
      </label>
      {advertising && (
        <label class="yu-check">
          <input type="checkbox" id="marketing" name="marketing" />
          <span>Согласен получать рекламу и акции – <a href="/advertising-consent/" target="_blank" rel="noopener">согласие на получение рекламных сообщений</a> (необязательно)</span>
        </label>
      )}
      <button class="yu-btn" type="submit" id="code-submit" disabled>Войти</button>
      <div class="yu-form__aside">
        <button class="yu-link-btn" type="button" id="resend" disabled>Отправить код ещё раз</button>
        <button class="yu-link-btn" type="button" id="change-phone">Изменить номер</button>
      </div>
    </form>

    <p class="yu-alert" id="auth-error" role="alert" aria-live="assertive"></p>
  </section>

  <script>
    import { SIGNED_IN_EVENT, browserCall, clientAuth, errorText, safeNext } from '../lib/client.ts';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const phoneForm = $<HTMLFormElement>('phone-form');
    const codeForm = $<HTMLFormElement>('code-form');
    const phoneInput = $<HTMLInputElement>('phone');
    const codeInput = $<HTMLInputElement>('code');
    const consent = $<HTMLInputElement>('consent');
    const phoneSubmit = $<HTMLButtonElement>('phone-submit');
    const codeSubmit = $<HTMLButtonElement>('code-submit');
    const resend = $<HTMLButtonElement>('resend');
    const errorBox = $<HTMLElement>('auth-error');
    const sent = $<HTMLElement>('code-sent');

    let challengeId = '';
    let timer: number | undefined;

    /** Десять цифр номера после +7: «8 913…», «+7 913…», «913…» – одинаково. */
    function digitsOf(value: string): string {
      let d = value.replace(/\D/g, '');
      if (value.trim().startsWith('+7')) d = d.slice(1);
      if (d.length > 10 && (d[0] === '7' || d[0] === '8')) d = d.slice(1);
      return d.slice(0, 10);
    }

    function format(d: string): string {
      if (!d) return '';
      let s = '+7 (' + d.slice(0, 3);
      if (d.length >= 3) s += ')';
      if (d.length > 3) s += ' ' + d.slice(3, 6);
      if (d.length > 6) s += '-' + d.slice(6, 8);
      if (d.length > 8) s += '-' + d.slice(8, 10);
      return s;
    }

    phoneInput.addEventListener('focus', () => {
      if (!phoneInput.value) phoneInput.value = '+7 (';
    });
    phoneInput.addEventListener('input', () => {
      phoneInput.value = format(digitsOf(phoneInput.value)) || '+7 (';
    });
    codeInput.addEventListener('input', () => {
      codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, 6);
    });
    consent.addEventListener('change', () => {
      codeSubmit.disabled = !consent.checked;
    });

    function startCountdown(sec: number) {
      window.clearInterval(timer);
      let left = Math.max(1, Math.round(sec));
      resend.disabled = true;
      const tick = () => {
        if (left <= 0) {
          window.clearInterval(timer);
          resend.disabled = false;
          resend.textContent = 'Отправить код ещё раз';
          return;
        }
        resend.textContent = `Отправить код ещё раз через ${left} с`;
        left -= 1;
      };
      tick();
      timer = window.setInterval(tick, 1000);
    }

    async function requestCode(): Promise<boolean> {
      errorBox.textContent = '';
      const d = digitsOf(phoneInput.value);
      if (d.length !== 10) {
        errorBox.textContent = 'Введите номер полностью: 10 цифр после +7.';
        phoneInput.focus();
        return false;
      }
      try {
        const r = await clientAuth.requestCode(`+7${d}`, crypto.randomUUID());
        challengeId = r.challengeId;
        sent.textContent = `Код отправлен на ${format(d)}. Он действует ${Math.round(r.expiresInSec / 60)} мин.`;
        startCountdown(r.resendAfterSec);
        return true;
      } catch (e) {
        errorBox.textContent = errorText(e);
        return false;
      }
    }

    phoneForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      phoneSubmit.disabled = true;
      const ok = await requestCode();
      phoneSubmit.disabled = false;
      if (!ok) return;
      phoneForm.hidden = true;
      codeForm.hidden = false;
      codeInput.focus();
    });

    resend.addEventListener('click', async () => {
      resend.disabled = true;
      if (!(await requestCode())) resend.disabled = false;
      codeInput.value = '';
      codeInput.focus();
    });

    $<HTMLButtonElement>('change-phone').addEventListener('click', () => {
      window.clearInterval(timer);
      errorBox.textContent = '';
      challengeId = '';
      codeForm.hidden = true;
      phoneForm.hidden = false;
      phoneInput.focus();
    });

    codeForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      errorBox.textContent = '';
      if (!consent.checked) return;
      if (!/^\d{6}$/.test(codeInput.value)) {
        errorBox.textContent = 'Код – это 6 цифр из SMS.';
        codeInput.focus();
        return;
      }
      codeSubmit.disabled = true;
      codeSubmit.textContent = 'Входим…';
      try {
        const marketing = document.getElementById('marketing') as HTMLInputElement | null;
        await browserCall('/auth/otp/verify', { challengeId, code: codeInput.value, consents: { pdProcessing: true, ...(marketing ? { marketing: marketing.checked } : {}) } });
        window.dispatchEvent(new CustomEvent(SIGNED_IN_EVENT));
        location.assign(safeNext(new URLSearchParams(location.search).get('next'), location.origin));
      } catch (e) {
        errorBox.textContent = errorText(e);
        codeSubmit.disabled = !consent.checked;
        codeSubmit.textContent = 'Войти';
        codeInput.select();
      }
    });
  </script>
</Site>

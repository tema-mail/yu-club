# Образец файла окружения стенда/боя: /opt/yu-club/.env (права 600). Настоящих значений здесь нет и быть не должно:
# секреты и пароли ролей БД генерирует deploy/deploy.sh на сервере один раз (openssl rand) и никуда не выводит.
# Запуск: docker compose --env-file /opt/yu-club/.env -f deploy/compose.yml up -d
# Смена SESSION_PEPPER разлогинивает всех, CERT_PEPPER – ломает коды сертификатов, пары VAPID – все push-подписки (TEHDOLG 1.5).

# ---- режим
APP_ENV=stage                    # prod – бой: индексация, боевой SMS-адаптер, запрет демо-данных (TEHDOLG 1.4)
LOG_LEVEL=info
GIT_SHA=                         # ставит deploy.sh при сборке образа API
PUBLIC_SITE_URL=https://yu-club.example.ru
TRUSTED_PROXIES=127.0.0.0/8,::1,172.16.0.0/12   # адреса своего обратного прокси (TEHDOLG 1.6)
CADDY_NETWORK=caddy              # внешняя сеть docker общего Caddy

# ---- база (роли – deploy/initdb/01-roles.sh)
POSTGRES_PASSWORD=
YU_OWNER_PASSWORD=
YU_APP_PASSWORD=
YU_BOSS_PASSWORD=
YU_REPORTS_PASSWORD=
DATA_DIR=/opt/yu-club/data
BACKUP_DIR=/opt/yu-club/backups
BACKUP_RETENTION_DAYS=14
BACKUP_ALERT_URL=                # POST при ошибке бэкапа (TEHDOLG 2.3)

# ---- секреты приложения (≥ 32 символов, генерирует deploy.sh)
SESSION_PEPPER=
CERT_PEPPER=
PREVIEW_SECRET=
# подпись ссылки отписки от рекламы (TEHDOLG 3.7)
UNSUBSCRIBE_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru

# ---- файлы (тома контейнера api; в бэкапе – вложения и медиатека)
ATTACHMENTS_HOST_DIR=/opt/yu-club/attachments
MEDIA_DIR=/opt/yu-club/media
MEDIA_QUOTA_GB=5
EXPORT_DIR=/opt/yu-club/exports

# ---- адреса контейнеров внутри сети (менять только при другой схеме compose)
CRM_API_URL=http://yu-club-api:3000
SITE_API_URL=http://yu-club-api:3000
SITE_INTERNAL_URL=http://yu-club-site:4341

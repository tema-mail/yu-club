---
// Смена своего пароля (K12 №4): новый ≥ 12 символов; остальные сессии сервер завершает сам.
// Форма помечена data-guard: несохранённый ввод переключатель контекста не потеряет молча.
import Crm from '../../layouts/Crm.astro';
---
<Crm title="Смена пароля">
  <div class="yc-head">
    <h1>Смена пароля</h1>
    <p>После смены другие ваши входы на других устройствах будут завершены.</p>
  </div>
  <section class="yc-panel" aria-label="Новый пароль">
    <form class="yc-form" id="password-form" data-guard novalidate>
      <label class="yc-field">
        <span class="yc-field__label">Текущий пароль</span>
        <input class="yc-input" type="password" name="currentPassword" autocomplete="current-password" required />
      </label>
      <label class="yc-field">
        <span class="yc-field__label">Новый пароль</span>
        <input class="yc-input" type="password" name="newPassword" autocomplete="new-password" minlength="12" required />
        <span class="yc-field__hint">Не короче 12 символов</span>
      </label>
      <label class="yc-field">
        <span class="yc-field__label">Новый пароль ещё раз</span>
        <input class="yc-input" type="password" name="repeat" autocomplete="new-password" required />
      </label>
      <p class="yc-alert" id="password-result" role="status" aria-live="polite"></p>
      <div>
        <button class="yc-btn" type="submit">Сменить пароль</button>
      </div>
    </form>
  </section>
</Crm>

<script>
  import { ApiError, auth } from '../../lib/api.ts';

  const form = document.getElementById('password-form') as HTMLFormElement;
  const result = document.getElementById('password-result') as HTMLElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  function show(text: string, ok: boolean) {
    result.textContent = text;
    result.className = `yc-alert ${ok ? 'yc-alert--ok' : 'yc-alert--error'}`;
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const data = new FormData(form);
    const current = String(data.get('currentPassword') ?? '');
    const next = String(data.get('newPassword') ?? '');
    const repeat = String(data.get('repeat') ?? '');
    if (!current) return show('Введите текущий пароль.', false);
    if (next.length < 12) return show('Новый пароль – не короче 12 символов.', false);
    if (next !== repeat) return show('Новые пароли не совпадают.', false);
    button.disabled = true;
    try {
      await auth.changePassword(current, next);
      form.reset();
      show('Пароль изменён.', true);
    } catch (e) {
      if (e instanceof ApiError && e.code === 'INVALID_CREDENTIALS') show('Текущий пароль указан неверно.', false);
      else show(e instanceof ApiError ? e.message : 'Не удалось сменить пароль. Повторите позже.', false);
    } finally {
      button.disabled = false;
    }
  });
</script>
